generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Role {
  id        String   @id @default(uuid())
  name      String   @unique

  users     User[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model User {
  id            String   @id @default(uuid())

  fullName      String
  email         String   @unique
  employeeId    String?  @unique
  phone         String   @unique

  passwordHash  String

  isVerified    Boolean  @default(false)

  roleId        String
  role          Role     @relation(fields: [roleId], references: [id], onDelete: Restrict)

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model EmailOTP {
  id          String   @id @default(uuid())

  email       String
  otp         String

  isUsed      Boolean  @default(false)

  expiresAt   DateTime

  createdAt   DateTime @default(now())
}
model Customer {
  id               String   @id @default(uuid()) @db.Uuid
  branchId         String?  @map("branch_id") @db.Uuid

  name             String
  phone            String   @unique
  email            String?  @unique
  address          String?

  loyaltyId        String?  @map("loyalty_id")

  creditLimit      Decimal  @default(0.00) @map("credit_limit") @db.Decimal(18,2)
  currentBalance   Decimal  @default(0.00) @map("current_balance") @db.Decimal(18,2)

  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@map("customers")
}

model Category {
  id          String    @id @default(uuid())
  name        String    @db.VarChar(100)
  code        String    @unique @db.VarChar(20)
  description String?
  image       String?
  status      Boolean   @default(true)

  products    Product[]

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("categories")
}

model Product {
  id            String    @id @default(uuid())
  name          String    @db.VarChar(150)
  sku           String    @unique @db.VarChar(50)
  barcode       String?   @unique @db.VarChar(100)

  categoryId    String
  category      Category  @relation(fields: [categoryId], references: [id])

  brandId       String?
  purchasePrice Decimal   @db.Decimal(10,2)
  sellingPrice  Decimal   @db.Decimal(10,2)
  quantity      Int       @default(0)
  unit          String     @default("PCS")
  image         String?
  description   String?
  status        Boolean    @default(true)

  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@map("products")
}

model SalesOrder {
  id               String   @id @default(uuid()) @db.Uuid

  branchId         String   @map("branch_id") @db.Uuid
  customerId       String?  @map("customer_id") @db.Uuid

  orderNumber      String   @unique @map("order_number")

  status           SalesOrderStatus @default(DRAFT)

  orderDate        DateTime @map("order_date")

  totalAmount      Decimal  @db.Decimal(18,2) @map("total_amount")

  taxAmount        Decimal  @default(0.00) @db.Decimal(18,2) @map("tax_amount")

  discountAmount   Decimal  @default(0.00) @db.Decimal(18,2) @map("discount_amount")

  netAmount        Decimal  @db.Decimal(18,2) @map("net_amount")

  createdAt        DateTime @default(now()) @map("created_at")

  updatedAt        DateTime @updatedAt @map("updated_at")

  @@map("sales_orders")
}