generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Role {
  id   String @id @default(uuid())
  name String @unique

  users User[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// DEPARTMENT

model Department {
  id          String   @id @default(uuid())
  name        String   @unique @db.VarChar(150)
  code        String   @unique @db.VarChar(50)
  head        String?  @db.VarChar(150)
  employees   Int      @default(0)
  status      Status   @default(ACTIVE)

  designations Designation[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([name])
  @@index([code])
  @@map("departments")
}

// DESIGNATION

model Designation {
  id          String   @id @default(uuid())
  code        String   @unique @db.VarChar(50)
  designation String   @db.VarChar(150)
  department  String   @db.VarChar(150)
  status      Status   @default(ACTIVE)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([designation])
  @@index([department])
  @@map("designations")
}


model User {
  id String @id @default(uuid())

  fullName String?

  email String @unique

  employeeId String? @unique

  phone String @unique

  passwordHash String

  isVerified Boolean @default(false)

  firstLogin Boolean @default(true)

  verificationToken   String?
  verificationExpires DateTime?

  roleId String?

  role Role? @relation(fields: [roleId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt
}

model EmailOTP {
  id String @id @default(uuid())

  email String

  otp String

  isUsed Boolean @default(false)

  expiresAt DateTime

  createdAt DateTime @default(now())
}

model Customer {
  id       String  @id @default(uuid()) @db.Uuid
  branchId String? @map("branch_id") @db.Uuid

  name    String
  phone   String  @unique
  email   String? @unique
  address String?

  loyaltyId String? @map("loyalty_id")

  creditLimit    Decimal @default(0.00) @map("credit_limit") @db.Decimal(18, 2)
  currentBalance Decimal @default(0.00) @map("current_balance") @db.Decimal(18, 2)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  payments Payment[]

  @@map("customers")
}

//Status

enum Status {
  ACTIVE
  INACTIVE
}

enum ProductStatus {
  ACTIVE
  INACTIVE
}

enum ProductDiscountType {
  PERCENT
  FIXED
}

enum PurchaseStatus {
  PENDING
  RECEIVED
  PARTIAL
  CANCELLED
}

enum TransferStatus {
  PENDING
  APPROVED
  COMPLETED
  CANCELLED
}

enum MovementType {
  PURCHASE
  SALE
  TRANSFER_IN
  TRANSFER_OUT
  ADJUSTMENT
}

// CATEGORY

model Category {
  id String @id @default(uuid())

  name String @db.VarChar(100)

  code String @unique @db.VarChar(20)

  description String?

  image String?

  status Status @default(ACTIVE)

  products Product[]

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@index([name])
  @@index([code])
  @@map("categories")
}

// BRAND

enum BrandStatus {
  ACTIVE
  INACTIVE
}

model Brand {
  id String @id @default(uuid())

  name String @unique @db.VarChar(100)

  description String? @db.Text

  status BrandStatus @default(ACTIVE)

  products Product[]

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@map("brands")
}

// PRODUCT

model Unit {
  id String @id @default(uuid())

  name String @unique @db.VarChar(50)

  code String @unique @db.VarChar(20)

  status Status @default(ACTIVE)

  products Product[]

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@index([name])
  @@map("units")
}

model Product {
  id String @id @default(uuid())

  name String @db.VarChar(150)

  sku String @unique @db.VarChar(50)

  categoryId String

  brandId String?

  unitId String

  costPrice Decimal @db.Decimal(18, 2)

  sellingPrice Decimal @db.Decimal(18, 2)

  discountType ProductDiscountType?

  discountValue Decimal? @db.Decimal(18, 2)

  image String?

   description String?

  status ProductStatus @default(ACTIVE)

  unit Unit @relation(fields: [unitId], references: [id])

  category Category @relation(fields: [categoryId], references: [id])

  brand Brand? @relation(fields: [brandId], references: [id])

  barcodes Barcode[]

  inventories Inventory[]

  purchaseItems PurchaseItem[]

  transferItems StockTransferItem[]

  stockMovements StockMovement[]

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@index([categoryId])
  @@index([brandId])
  @@index([unitId])
  @@map("products")
}

// BARCODE

model Barcode {
  id String @id @default(uuid())

  productId String

  barcode String @unique @db.VarChar(100)

  type String @default("CODE128")

  product Product @relation(fields: [productId], references: [id])

  createdAt DateTime @default(now())

  @@index([productId])
  @@map("barcodes")
}

// SUPPLIER

model Supplier {
  id String @id @default(uuid())

  companyName String @db.VarChar(150)

  contactPerson String? @db.VarChar(100)

  email String? @unique @db.VarChar(150)

  phone String @db.VarChar(20)

  address String?

  city String?

  state String?

  country String?

  taxNumber String?

  status Status @default(ACTIVE)

  purchases Purchase[]

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@index([companyName])
  @@map("suppliers")
}

// WAREHOUSE

model Warehouse {
  id String @id @default(uuid())

  name String @db.VarChar(150)

  code String @unique @db.VarChar(50)

  address String?

  city String?

  state String?

  country String?

  phone String?

  status Status @default(ACTIVE)

  inventories Inventory[]

  stockMovements StockMovement[]

  purchases Purchase[]

  fromTransfers StockTransfer[] @relation("FromWarehouse")

  toTransfers StockTransfer[] @relation("ToWarehouse")

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@index([name])
  @@index([code])
  @@map("warehouses")
}

// INVENTORY

model Inventory {
  id String @id @default(uuid())

  productId String

  warehouseId String

  quantity Int @default(0)

  minimumStock Int @default(10)

  maximumStock Int @default(1000)

  reorderLevel Int @default(20)

  product Product @relation(fields: [productId], references: [id])

  warehouse Warehouse @relation(fields: [warehouseId], references: [id])

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@unique([productId, warehouseId])
  @@index([productId])
  @@index([warehouseId])
  @@map("inventory")
}

// PURCHASE

model Purchase {
  id String @id @default(uuid())

  purchaseNo String @unique @db.VarChar(50)

  supplierId String

  warehouseId String

  purchaseDate DateTime @default(now())

  totalAmount Decimal @db.Decimal(18, 2)

  status PurchaseStatus @default(PENDING)

  notes String?

  supplier Supplier @relation(fields: [supplierId], references: [id])

  warehouse Warehouse @relation(fields: [warehouseId], references: [id])

  items PurchaseItem[]

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@index([supplierId])
  @@index([warehouseId])
  @@map("purchases")
}

model PurchaseItem {
  id String @id @default(uuid())

  purchaseId String

  productId String

  quantity Int

  unitPrice Decimal @db.Decimal(18, 2)

  totalPrice Decimal @db.Decimal(18, 2)

  purchase Purchase @relation(fields: [purchaseId], references: [id])

  product Product @relation(fields: [productId], references: [id])

  @@index([purchaseId])
  @@index([productId])
  @@map("purchase_items")
}

// STOCK MOVEMENT HISTORY

model StockMovement {
  id String @id @default(uuid())

  productId String

  warehouseId String

  type MovementType

  quantity Int

  referenceNo String?

  remarks String?

  performedBy String?

  product Product @relation(fields: [productId], references: [id])

  warehouse Warehouse @relation(fields: [warehouseId], references: [id])

  createdAt DateTime @default(now())

  @@index([productId])
  @@index([warehouseId])
  @@map("stock_movements")
}

// STOCK TRANSFER

model StockTransfer {
  id String @id @default(uuid())

  transferNo String @unique @db.VarChar(50)

  fromWarehouseId String
  toWarehouseId   String

  transferDate DateTime @default(now())

  status TransferStatus @default(PENDING)

  reason String?

  remarks String?

  approvedBy String?

  fromWarehouse Warehouse @relation("FromWarehouse", fields: [fromWarehouseId], references: [id])

  toWarehouse Warehouse @relation("ToWarehouse", fields: [toWarehouseId], references: [id])

  items StockTransferItem[]

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@index([fromWarehouseId])
  @@index([toWarehouseId])
  @@map("stock_transfers")
}

model StockTransferItem {
  id String @id @default(uuid())

  stockTransferId String

  productId String

  quantity Int

  stockTransfer StockTransfer @relation(fields: [stockTransferId], references: [id])

  product Product @relation(fields: [productId], references: [id])

  @@index([stockTransferId])
  @@index([productId])
  @@map("stock_transfer_items")
}

model SalesOrder {
  id String @id @default(uuid()) @db.Uuid

  branchId   String  @map("branch_id") @db.Uuid
  customerId String? @map("customer_id") @db.Uuid

  orderNumber String @unique @map("order_number")

  status SalesOrderStatus @default(DRAFT)

  orderDate DateTime @map("order_date")

  totalAmount Decimal @map("total_amount") @db.Decimal(18, 2)

  taxAmount Decimal @default(0.00) @map("tax_amount") @db.Decimal(18, 2)

  discountAmount Decimal @default(0.00) @map("discount_amount") @db.Decimal(18, 2)

  netAmount Decimal @map("net_amount") @db.Decimal(18, 2)

  createdAt DateTime @default(now()) @map("created_at")

  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("sales_orders")
}

enum SalesOrderStatus {
  DRAFT
  CONFIRMED
  PROCESSING
  COMPLETED
  CANCELLED
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PARTIAL
  PAID
  REFUNDED
}

model Invoice {
  id String @id @default(uuid()) @db.Uuid

  branchId     String  @map("branch_id") @db.Uuid
  salesOrderId String? @map("sales_order_id") @db.Uuid
  customerId   String  @map("customer_id") @db.Uuid

  invoiceNumber String @unique @map("invoice_number")

  invoiceDate DateTime  @map("invoice_date")
  dueDate     DateTime? @map("due_date")

  subtotal Decimal @db.Decimal(18, 2)

  taxAmount Decimal @default(0) @map("tax_amount") @db.Decimal(18, 2)

  discountAmount Decimal @default(0) @map("discount_amount") @db.Decimal(18, 2)

  totalAmount Decimal @map("total_amount") @db.Decimal(18, 2)

  paidAmount Decimal @default(0) @map("paid_amount") @db.Decimal(18, 2)

  balanceAmount Decimal @default(0) @map("balance_amount") @db.Decimal(18, 2)

  paymentStatus PaymentStatus @default(PENDING)

  status InvoiceStatus @default(DRAFT)

  notes String?

  createdAt DateTime @default(now()) @map("created_at")

  updatedAt DateTime @updatedAt @map("updated_at")

  items InvoiceItem[]

  payments Payment[]

  @@map("invoices")
}

model InvoiceItem {
  id String @id @default(uuid()) @db.Uuid

  invoiceId String @map("invoice_id") @db.Uuid

  productId String @map("product_id") @db.Uuid

  quantity Int

  unitPrice Decimal @map("unit_price") @db.Decimal(18, 2)

  discount Decimal @default(0) @db.Decimal(18, 2)

  tax Decimal @default(0) @db.Decimal(18, 2)

  total Decimal @db.Decimal(18, 2)

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@map("invoice_items")
}

// ==============================
// Payment Enums
// ==============================

enum PaymentMethod {
  CASH
  CARD
  BANK
  WALLET
  OTHER
}

// ==============================
// Payment Model
// ==============================

model Payment {
  id String @id @default(uuid()) @db.Uuid

  branchId        String  @map("branch_id") @db.Uuid
  customerId      String? @map("customer_id") @db.Uuid
  supplierId      String? @map("supplier_id") @db.Uuid
  invoiceId       String? @map("invoice_id") @db.Uuid
  purchaseOrderId String? @map("purchase_order_id") @db.Uuid

  paymentNumber String   @unique @map("payment_number")
  paymentDate   DateTime @map("payment_date")

  amount Decimal @db.Decimal(18, 2)

  method PaymentMethod

  referenceNumber String? @map("reference_number")

  status PaymentStatus @default(PENDING)

  notes String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Existing models only
  customer Customer? @relation(fields: [customerId], references: [id])
  invoice  Invoice?  @relation(fields: [invoiceId], references: [id])

  @@map("payments")
}

// ==============================
// Return Enums
// ==============================

enum ReturnType {
  SALES_RETURN
  PURCHASE_RETURN
}

// ==============================
// Return Model
// ==============================

model Return {
  id String @id @default(uuid()) @db.Uuid

  branchId String @map("branch_id") @db.Uuid

  type ReturnType

  referenceSalesOrderId String? @map("reference_sales_order_id") @db.Uuid

  referencePurchaseOrderId String? @map("reference_purchase_order_id") @db.Uuid

  returnNumber String @unique @map("return_number")

  returnDate DateTime @map("return_date")

  totalAmount Decimal @map("total_amount") @db.Decimal(18, 2)

  taxAmount Decimal @default(0.00) @map("tax_amount") @db.Decimal(18, 2)

  netAmount Decimal @map("net_amount") @db.Decimal(18, 2)

  createdAt DateTime @default(now()) @map("created_at")

  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("returns")
}

// ==============================
// Discount Enums
// ==============================

enum DiscountType {
  PERCENTAGE
  FIXED
}

enum DiscountStatus {
  ACTIVE
  INACTIVE
  EXPIRED
}

// ==============================
// Discount Model
// ==============================

model Discount {
  id String @id @default(uuid()) @db.Uuid

  branchId String @map("branch_id") @db.Uuid

  name String @db.VarChar(100)

  code String @unique @db.VarChar(50)

  type DiscountType

  value Decimal @db.Decimal(18, 2)

  minimumOrderAmount Decimal @default(0) @map("minimum_order_amount") @db.Decimal(18, 2)

  maximumDiscount Decimal? @map("maximum_discount") @db.Decimal(18, 2)

  startDate DateTime @map("start_date")

  endDate DateTime @map("end_date")

  status DiscountStatus @default(ACTIVE)

  description String?

  createdAt DateTime @default(now()) @map("created_at")

  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("discounts")
}

//landing page database design

model LandingPage {
  id String @id @default(uuid())

  heroTitle       String
  heroDescription String
  heroImage       String?

  aboutTitle       String
  aboutDescription String

  aboutImage1 String?
  aboutImage2 String?
  aboutImage3 String?
  aboutImage4 String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("landing_page")
}

// ==============================
// Tax Enums
// ==============================

enum TaxType {
  INCLUSIVE
  EXCLUSIVE
}

enum TaxStatus {
  ACTIVE
  INACTIVE
}

// ==============================
// Tax Model
// ==============================

model Tax {
  id String @id @default(uuid()) @db.Uuid

  name String @db.VarChar(100)

  rate Decimal @db.Decimal(5, 2)

  type TaxType

  status TaxStatus @default(ACTIVE)

  createdAt DateTime @default(now()) @map("created_at")

  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("taxes")
}

// ==============================
// Audit Log Model
// ==============================

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?  @map("user_id")
  userName  String?  @map("user_name")
  userEmail String?  @map("user_email")
  action    String   @db.VarChar(50) // CREATE, UPDATE, DELETE, LOGIN, LOGOUT, EXPORT, etc.
  entity    String   @db.VarChar(100) // Employee, Product, Customer, Invoice, Auth, etc.
  entityId  String?  @map("entity_id")
  details   Json?    // Detailed metadata, old/new values, request data
  ipAddress String?  @map("ip_address") @db.VarChar(45)
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([action])
  @@index([entity])
  @@index([createdAt])
  @@map("audit_logs")
}

// ==============================
// System Settings Model
// ==============================

model SystemSettings {
  id String @id @default(uuid())

  // Business Info
  companyName    String  @default("ERP Enterprise Ltd") @map("company_name")
  legalName      String? @map("legal_name")
  taxNumber      String? @map("tax_number")
  companyEmail   String? @map("company_email")
  companyPhone   String? @map("company_phone")
  companyAddress String? @map("company_address")
  companyLogo    String? @map("company_logo")

  // Localization & Finance
  currency        String @default("USD")
  currencySymbol  String @default("$") @map("currency_symbol")
  timezone        String @default("UTC")
  dateFormat      String @default("YYYY-MM-DD") @map("date_format")
  fiscalYearStart String @default("January") @map("fiscal_year_start")

  // Invoicing & Sales
  invoicePrefix       String  @default("INV-") @map("invoice_prefix")
  salesOrderPrefix    String  @default("SO-") @map("sales_order_prefix")
  purchaseOrderPrefix String  @default("PO-") @map("purchase_order_prefix")
  defaultTaxRate      Decimal @default(0.00) @map("default_tax_rate") @db.Decimal(5, 2)
  enableMultiBranch   Boolean @default(false) @map("enable_multi_branch")

  // Inventory & POS
  enableStockAlerts Boolean @default(true) @map("enable_stock_alerts")
  lowStockThreshold Int     @default(10) @map("low_stock_threshold")
  receiptHeader     String? @map("receipt_header")
  receiptFooter     String? @default("Thank you for your business!") @map("receipt_footer")
  receiptPaperSize  String  @default("80mm") @map("receipt_paper_size")
  autoPrintReceipt  Boolean @default(true) @map("auto_print_receipt")
  showTaxOnReceipt  Boolean @default(true) @map("show_tax_on_receipt")

  // Security & Preferences
  emailNotifications    Boolean @default(true) @map("email_notifications")
  dailyReportEmail      Boolean @default(false) @map("daily_report_email")
  sessionTimeoutMinutes Int     @default(60) @map("session_timeout_minutes")
  themePreference       String  @default("system") @map("theme_preference")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("system_settings")
}

model Branch {
  id        String   @id @default(uuid())
  name      String
  code      String   @unique
  address   String?
  city      String?
  state     String?
  phone     String?
  email     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}